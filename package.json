{
	"name": "pygors",
	"description": "Python, Rust and Go side by side: a cheatsheet for a Python developer learning Rust and Go",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"author": "Morgan Williams",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrgnw/pygorst.git"
	},
	"homepage": "https://pygors.xces.workers.dev",
	"bugs": {
		"url": "https://github.com/mrgnw/pygorst/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 5238",
		"ship": "pnpm build && wrangler deploy",
		"cfb": "pnpm build && wrangler versions upload --preview-alias $(git branch --show-current | sed 's/[^a-zA-Z0-9-]/-/g')",
		"prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"marked": "^18.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-checker": "^1.0.0",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
